// ============================================================
// CLIENT CONFIGS — TabICL MCP
// Local (stdio): uvx tabicl-mcp   |   Remote: https://YOUR-SPACE.hf.space/mcp
// ============================================================

// ----------------------------------------------------------
// 1. CLAUDE DESKTOP (local stdio)
// File: ~/Library/Application Support/Claude/claude_desktop_config.json (macOS)
//       %APPDATA%\Claude\claude_desktop_config.json (Windows)
// ----------------------------------------------------------
{
  "mcpServers": {
    "tabicl": { "command": "uvx", "args": ["tabicl-mcp"] }
  }
}
// pip alternative: { "command": "tabicl-mcp" }  (or full venv path)

// ----------------------------------------------------------
// 2. CLAUDE CODE (CLI)
//   claude mcp add tabicl -- uvx tabicl-mcp
// ----------------------------------------------------------

// ----------------------------------------------------------
// 3. VS CODE / CURSOR (local stdio)
// File: .vscode/mcp.json in your workspace (or Cursor Settings > MCP)
// ----------------------------------------------------------
{
  "servers": {
    "tabicl": { "type": "stdio", "command": "uvx", "args": ["tabicl-mcp"] }
  }
}

// ----------------------------------------------------------
// 4. CLAUDE.AI (remote, Streamable HTTP)
// Settings > Connectors > Add custom connector
// URL: https://YOUR-SPACE.hf.space/mcp
// ----------------------------------------------------------

// ----------------------------------------------------------
// 5. CHATGPT (remote, Streamable HTTP)
// Requires a paid plan. Settings > enable Developer Mode,
// then Apps & Connectors > Add custom connector
// URL: https://YOUR-SPACE.hf.space/mcp
// ----------------------------------------------------------

